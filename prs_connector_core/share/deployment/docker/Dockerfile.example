FROM python:3.12-slim

WORKDIR /app

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY . /app

ENV PYTHONUNBUFFERED=1
ENV PRS_CONNECTOR_CONFIG=/configs/config.json

# Точка входа: модуль коннектора, вызывающий prs_connector_core.main(...).
# Путь к конфигу: --config, позиционный argv, PRS_CONNECTOR_CONFIG или ./config.json.
CMD ["python", "/app/connector.py"]
